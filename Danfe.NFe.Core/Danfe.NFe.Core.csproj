<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>

    <!-- Identidade do pacote -->
    <PackageId>Danfe.NFe.Core</PackageId>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>

    <!-- Metadata -->
    <Authors>Bruno Moreno (bsmoreno2910); Alexandre Laranjeiras (original); SilverCard (DanfeSharp)</Authors>
    <Company>Bruno Moreno</Company>
    <Copyright>Copyright © 2026 Bruno Moreno</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Description>Gerador de DANFE NFe modelo 55 em PDF. Refatorado para PdfSharpCore, compatível com .NET Standard 2.0 e .NET 8. Fork/refactor de Zion.NFe.Danfe (Laranjeiras) / DanfeSharp (SilverCard).</Description>
    <PackageTags>danfe;nfe;nota-fiscal-eletronica;pdf;pdfsharpcore;brasil;fiscal</PackageTags>
    <PackageReleaseNotes>v3.0.0 - Leiaute do DANFE conforme a NT 2026.010 (Reforma Tributária: IBS, CBS e IS): novo bloco "Total do IBS / CBS / IS"; totais divididos em "Total dos Produtos e Total da Nota" e "Total do ICMS / IPI" com campos condicionados (FCP, DIFAL, ICMS monofásico); CRT e Tipo de Regime de Apuração do IBS/CBS no quadro do emitente; novo quadro de produtos com cClassTrib, bases, alíquotas (efetivas quando há gRed) e valores de ICMS, IBS UF, IBS Município, CBS, IS e IPI; quadro de QR Code quando o XML possui infNFeSupl/qrCode; ISSQN e Transportador exibidos somente quando aplicáveis.</PackageReleaseNotes>

    <!-- Links -->
    <PackageProjectUrl>https://github.com/bsmoreno2910/Danfe.NFe.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bsmoreno2910/Danfe.NFe.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Licença -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- README embarcado (aparece na página do pacote no nuget.org) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols para debug dos consumidores (snupkg = NuGet.org padrão) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- README do repo é empacotado na raiz do .nupkg -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
